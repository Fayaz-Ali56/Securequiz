# Copy to .env and fill in after running the deploy script (npm run deploy:sepolia
# in the project root). The deploy script prints both addresses at the end.
VITE_GAME_ADDRESS=
VITE_PLAY_TOKEN_ADDRESS=

# Must match the network you deployed to.
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia

# Optional: lets the app show questions before a wallet is connected.
# Same RPC URL you used in the root .env for SEPOLIA_RPC_URL.
VITE_RPC_URL=

# Required for connecting from the native mobile app (MetaMask Mobile, etc.)
# Free project ID from https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Fill in after running npm run deploy-badge:sepolia
VITE_BADGE_ADDRESS=
