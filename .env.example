# Copy this file to .env and fill in real values. Never commit .env!

# Get a free RPC URL from Alchemy or Infura for Sepolia testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Public Polygon RPC works fine for small deployments; use Alchemy/Infura for anything serious
POLYGON_RPC_URL=https://polygon-rpc.com

# Private key of the wallet you're deploying from - NO 0x prefix
# NEVER use a wallet that holds real funds you care about for testnet work.
# For the Polygon deployment, use a wallet funded with only a few dollars.
PRIVATE_KEY=

# For verifying contracts on block explorers (free accounts)
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
